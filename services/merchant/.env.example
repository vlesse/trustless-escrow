# 链的节点
RPC_URL=https://bsc-testnet-rpc.publicnode.com

# 卖家自己的钱包私钥（就是收货款的那个钱包）。
# 它碰不到任何买家的钱，但你的收入会进这个钱包 —— 定期转到冷钱包，这里只留补押金的零钱。
SELLER_PRIVATE_KEY=

# 店铺合约（公示站上有）
MERCHANT_BOND=

# 卡密放在哪：每个商品一个文件，文件名是商品编号，比如 codes/1.txt，一行一张
CODES_DIR=./codes

# 程序自己的账本：每一单分到了哪张卡密。丢了它就不知道哪些卡密已经发出去了 —— 要备份
STATE_FILE=./.merchant-state.json

# 多久检查一次（毫秒）
POLL_MS=20000

# 押金账户保持够接几单。0 = 不自动补
TOPUP_ORDERS=3
