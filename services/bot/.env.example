# 从 @BotFather 获取
TELEGRAM_BOT_TOKEN=

# --- 链 ---
RPC_URL=https://bsc-testnet-rpc.publicnode.com
CHAIN_ID=97
ESCROW_FACTORY=0x...
EXPLORER_URL=https://testnet.bscscan.com

# 公示站。机器人会让用户拿链上读到的仲裁层地址和这里公示的那份比对。
# 不配也能用，只是少了一个独立于机器人的参照物 —— 而「结论由我给、
# 验证手段也只在我手里」正是这个项目要避免的形状。
PUBLIC_SITE_URL=https://rrdb.renrenyings.net

# 主网时改成：
#   RPC_URL=https://bsc-dataseed.bnbchain.org
#   CHAIN_ID=56
#   EXPLORER_URL=https://bscscan.com

# 签名页地址。留空则只输出原始 calldata（用户可粘贴进任何钱包）。
# 机器人永远不接触私钥，签名一律在用户自己的钱包里完成。
SIGNING_PAGE_URL=

# --- 运行 ---
RATE_LIMIT_PER_MIN=20
POLL_TIMEOUT_SEC=30
STATE_FILE=./.bot-state.json

# --- 事件推送 ---
# 推送前等待的确认数。通知是「钱到账了」这类不可撤回的判断，
# 重组后已推送的消息会变成假消息，而用户可能已经据此发了货。
CONFIRMATIONS=5
WATCH_INTERVAL_MS=30000
# 首次启动从哪个区块开始扫描。之后游标会落盘，这个值只在第一次生效。
# 填 0 表示「从节点还留着的最早位置开始」—— 填一个很老的区块没有用：
# 公共节点只保留最近约 5 万块的日志（BSC 上不到 7 小时），更早的请求会直接报错。
WATCH_FROM_BLOCK=0

# 节点保留多久的日志（区块数）。游标落后超过这个数就跳到能拿得到的位置，
# 并在日志里说明跳过了多少。
# 由此带来一条必须让用户知道的性质：**通知是尽力而为的，不是保证**。
# 机器人停机超过这个窗口就会漏事件；资金状态的权威来源是 /deal，
# 它直接读合约当前状态，不依赖任何日志。
MAX_LOOKBACK_BLOCKS=45000

# ---- 信誉层（可选）----
# 两个都填上才启用。只填一个会误导用户：没接押金合约时，
# 「押金 0」和「真的没有押金」在界面上长得一模一样。
# 不填则 /rep /bond /unbond /record 回一句「未接入」，担保交易功能完全不受影响。
REPUTATION=
IDENTITY_BOND=

# 商家额度池（可选）。不配置则 /quota 只回一句「未接入」，担保交易不受影响。
MERCHANT_BOND=

# 陪审团抽选风险预警（可选）。两个都填才会跑。
# ALERT_CHAT_ID 是公开频道/群的 chat id —— 刻意做成公开广播而不是私发给运营方：
# 纠错权本来就对所有人开放，缺的只是有人注意到。私发等于把那个单点请回来。
STAKED_JURY=
ALERT_CHAT_ID=
