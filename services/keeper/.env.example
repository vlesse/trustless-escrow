# --- 链 ---
RPC_URL=https://arb1.arbitrum.io/rpc
ESCROW_FACTORY=0x...

# 推进用的私钥。
#
# 这把钥匙偷走一文不值：它能做的每一件事，合约上任何人都能做（抽签、开揭示、
# 计票、结案）。它碰不到任何人的资金，也没有任何管理员权限，所以可以热放在
# 服务器上。但**不要和提案人的钥匙（要质押、会被罚没）或管理员的钥匙
# （能停新单）共用** —— 那三种东西的风险等级完全不同。
#
# 里面只需要放 gas。
KEEPER_PRIVATE_KEY=0x...

# --- 要推哪几层（不填就跳过那一层）---
OPTIMISTIC_ARBITRATOR=
STAKED_JURY=
REPUTATION=

# --- 行为 ---
# 干跑：只算出该推什么并打印，不发交易。默认 true。
# 先观察几轮，确认它推的都是该推的，再改 false。
DRY_RUN=true

POLL_INTERVAL_MS=60000

# 单笔 gas 上限。推进类调用的成本是可预期的，远超这个数说明链上状态和预期
# 不符，宁可不发也不要盲目烧钱。
MAX_GAS_PER_TX=2000000

# 一轮最多发多少笔，防止某次异常一口气打出几百笔交易。
MAX_TX_PER_TICK=20

# 连续失败多少次之后放弃这个目标。
MAX_ATTEMPTS=5

LOOKBACK_BLOCKS=50000
STATE_FILE=./.keeper-state.json
