# --- 链 ---
RPC_URL=https://bsc-testnet-rpc.publicnode.com
OPTIMISTIC_ARBITRATOR=0x...
ESCROW_FACTORY=0x...

# 提案人私钥。必须与合约里 proposer() 返回的地址一致，否则提交会被 NotProposer 拒绝。
# 这是热钱包，只放够质押用的额度，不要放大额资金。
PROPOSER_PRIVATE_KEY=0x...

# --- Claude ---
# 不设则由 SDK 自行解析凭证（ANTHROPIC_AUTH_TOKEN 或 `ant auth login` 的 profile）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- 行为 ---
# 干跑：只算不提交。默认 true。观察若干真实案件后再改 false。
DRY_RUN=true

# 低于此置信度一律弃权，让案件升级到人类陪审团
MIN_CONFIDENCE=0.8

POLL_INTERVAL_MS=30000
MAX_EVIDENCE_ITEMS=20
MAX_EVIDENCE_BYTES=262144
FETCH_TIMEOUT_MS=10000
IPFS_GATEWAY=https://ipfs.io/ipfs/
STATE_FILE=./.proposer-state.json
